{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "codex-menu-meter-sync",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "../src/mobile",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_ACCOUNTS",
        "class_name": "SyncAccount"
      }
    ]
  },
  "exports": {
    "SyncAccount": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
